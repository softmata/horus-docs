{
  "name": "horus-docs",
  "license": "Apache-2.0",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-sidebar.js && node scripts/build-search-index.js && node scripts/build-llms-full.js && next dev -p 3009 -H 0.0.0.0",
    "build": "node scripts/build-sidebar.js && node scripts/build-search-index.js && node scripts/build-llms-full.js && node scripts/pre-render-mermaid.mjs && node scripts/extract-code-blocks.mjs && next build",
    "build:sidebar": "node scripts/build-sidebar.js",
    "build:search": "node scripts/build-search-index.js",
    "build:llms": "node scripts/build-llms-full.js",
    "build:all-ai": "node scripts/build-search-index.js && node scripts/build-llms-full.js && node scripts/extract-code-blocks.mjs",
    "start": "next start -p 3009 -H 0.0.0.0",
    "lint": "next lint",
    "validate": "node scripts/validate-docs.js",
    "extract:code": "node scripts/extract-code-blocks.mjs",
    "extract:code:verbose": "node scripts/extract-code-blocks.mjs --verbose",
    "verify": "node scripts/verify-all.mjs",
    "verify:rust": "node scripts/verify-rust-local.mjs",
    "verify:python": "node scripts/verify-python-local.mjs",
    "verify:cli": "node scripts/verify-cli-commands.mjs",
    "verify:toml": "node scripts/verify-toml-configs.mjs"
  },
  "dependencies": {
    "@types/prismjs": "^1.26.5",
    "@vercel/analytics": "^1.5.0",
    "flexsearch": "^0.8.212",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.12.2",
    "next": "^15.5.19",
    "next-mdx-remote": "^6.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.3.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.22.2",
    "unist-util-visit": "^5.0.0"
  },
  "overrides": {
    "lodash-es": "^4.17.23"
  },
  "devDependencies": {
    "@types/flexsearch": "^0.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
