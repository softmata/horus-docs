{
  "name": "horus-docs",
  "license": "Apache-2.0",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-search-index.js && next dev -p 3009 -H 0.0.0.0",
    "build": "node scripts/build-search-index.js && next build",
    "build:search": "node scripts/build-search-index.js",
    "start": "next start -p 3009 -H 0.0.0.0",
    "lint": "next lint",
    "check:links": "node scripts/check-links.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:parity": "node scripts/check-parity-coverage.mjs",
    "check": "npm run check:links && npm run check:claims && npm run check:parity",
    "extract:code": "node scripts/extract-code-blocks.mjs",
    "extract:code:verbose": "node scripts/extract-code-blocks.mjs --verbose",
    "verify:rust": "node scripts/verify-rust-local.mjs --horus-path ../horus",
    "verify:python": "node scripts/verify-python-local.mjs && python3 scripts/verify_python_api.py --horus-path ../horus",
    "verify:python:api": "python3 scripts/verify_python_api.py --horus-path ../horus",
    "verify:cpp": "node scripts/verify-cpp-local.mjs --horus-path ../horus",
    "verify:code": "npm run extract:code && npm run verify:rust && npm run verify:python && npm run verify:cpp"
  },
  "dependencies": {
    "@types/prismjs": "^1.26.5",
    "flexsearch": "^0.8.212",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.12.2",
    "next": "^15.5.12",
    "next-mdx-remote": "^6.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.3.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.22.2",
    "unist-util-visit": "^5.0.0"
  },
  "overrides": {
    "lodash-es": "^4.17.23",
    "nanoid": "^3.3.18",
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/flexsearch": "^0.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
