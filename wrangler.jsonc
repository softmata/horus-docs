{
  // Deploy the docs as a Cloudflare Worker that serves the Next static export (out/) as static assets.
  //
  // Having this file makes `wrangler deploy` use it INSTEAD of auto-detecting Next.js and running OpenNext
  // (the Next *server* adapter). OpenNext is wrong for our `output: 'export'` static build: it expects
  // `.next/standalone/`, which `next export` never emits, and fails with
  //   ENOENT: .next/standalone/.next/server/pages-manifest.json
  // See horus-blog/wrangler.jsonc — same fix, same reason.
  //
  // Unlike horus-blog there is no `basePath`, so the docs serve at the domain root and need NO worker
  // script — this is an assets-only Worker (no `main`, no ASSETS binding).
  //
  // `out/_headers` (CSP + HSTS) and `out/_redirects` (the extension-less /api/* rewrites) are honored by
  // Workers static assets exactly as they were on Pages — do not delete them.
  "name": "horus-docs",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
