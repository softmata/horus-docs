# Cloudflare Pages rewrites (200 = serve without changing the URL).
# Preserve the original extension-less raw-content API URLs on top of the static
# JSON files generated by scripts/build-content-api.mjs.
/api/health        /api/health.json      200
/api/docs          /api/docs.json        200
/api/docs/*        /api/docs/:splat.json  200
